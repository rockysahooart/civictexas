# Civic Texas environment variables. Copy to .env (ingestion) and web/.env.local (app).
# Never commit real values. .env files are git-ignored.

# --- Database (server-side only) --------------------------------------------
# Local: the project-local Postgres started by scripts/dev-db.sh
# Supabase: Project Settings > Database > Connection string (use the transaction
# pooler, port 6543, for the web app on Vercel).
DATABASE_URL=postgresql://postgres@localhost:54329/civictexas

# --- Ingestion ---------------------------------------------------------------
TLC_FTP_BASE=ftp://ftp.legis.state.tx.us/bills
INGEST_REQUEST_INTERVAL_SECONDS=1.0   # minimum gap between requests to the source
INGEST_MAX_RETRIES=3
INGEST_REQUEST_TIMEOUT_SECONDS=60
INGEST_FETCH_DOCUMENTS=true           # download bill text and fiscal note HTML
INGEST_MAX_DOCUMENT_BYTES=5000000     # skip (and log) documents larger than this
SYNC_MIN_INTERVAL_MINUTES=60          # incremental syncs closer together than this are skipped

# Supplementary sources (not used yet)
OPEN_STATES_API_KEY=

# --- Web app -----------------------------------------------------------------
# Data older than this is shown with a "may be out of date" notice.
NEXT_PUBLIC_STALE_AFTER_HOURS=48

# --- AI summarization (not active; no provider is configured) ----------------
SUMMARY_PROVIDER=
SUMMARY_MODEL=
SUMMARY_API_KEY=
